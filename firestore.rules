rules_version = '2';

// ============================================================
//  REGRAS DE SEGURANÇA — edite as listas de e-mails abaixo
// ============================================================
// Por que usar lista de e-mails? A chave de API do Firebase é pública (fica no site),
// e qualquer pessoa poderia criar uma conta nova. Só os e-mails listados aqui têm acesso.

service cloud.firestore {
  match /databases/{database}/documents {

    // E-mail do usuário do ESP32 (o mesmo do config.h)
    function isDevice() {
      return request.auth != null
          && request.auth.token.email == 'dispositivo@horimetro.com';
    }

    // E-mails de quem pode usar o painel (adicione os integrantes do grupo)
    function isDashboardUser() {
      return request.auth != null
          && request.auth.token.email in [
               'grupo@horimetro.com',
               'professor@horimetro.com'
             ];
    }

    // Estado ao vivo: o ESP32 grava, o painel lê
    match /status/{docId} {
      allow read: if isDashboardUser();
      allow write: if isDevice();
    }

    // Sessões de uso: o ESP32 grava (sem apagar), o painel lê
    match /sessions/{sessionId} {
      allow read: if isDashboardUser();
      allow create, update: if isDevice()
        && request.resource.data.duration_s is int
        && request.resource.data.duration_s > 0
        && request.resource.data.duration_s <= 86400;
      allow delete: if false;
    }

    // Plano de manutenção, registros e ajustes: somente o painel
    match /tasks/{taskId} {
      allow read, write: if isDashboardUser();
    }
    match /task_log/{logId} {
      allow read, create: if isDashboardUser();
      allow update, delete: if false;
    }
    match /settings/{docId} {
      allow read, write: if isDashboardUser();
    }
  }
}
